<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!--
            Tests run against an in-memory SQLite database by default, which
            needs no setup. Override with real environment variables to run
            them elsewhere, e.g.
            DB_CONNECTION=mysql DB_PORT=3306 DB_DATABASE=cce_test php artisan test
        -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Payments are never real in tests; Stripe itself is faked. -->
        <env name="STRIPE_KEY" value="pk_test_phpunit"/>
        <env name="STRIPE_SECRET" value="sk_test_phpunit"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="whsec_phpunit"/>
    </php>
</phpunit>
