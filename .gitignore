/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/vendor
.env
.env.backup
.env.production
# Overrides .env wholesale on a developer machine. Holds real SMTP credentials
# when MAIL_MAILER=smtp-live, so it must never be committed.
# Note it is only picked up when APP_ENV is set in the environment, and then it
# REPLACES .env rather than merging - a stale copy silently hides every setting
# in .env. Prefer editing .env; rename a file you no longer want to
# .env.local.bak rather than leaving it in place.
.env.local
.env.*.bak
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode

# Left behind only if a test run is killed mid-way. The real copy of the course
# content is database/data/course-content.json — never commit this.
database/data/*.test-backup

# Scratch and temporary zip archives
scratch/
*.zip
