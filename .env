# ---------------------------------------------------------------------------
# Course access
# ---------------------------------------------------------------------------
# Is a paid purchase required to open a course?
#
# false  every signed-in account can open every lesson and paper. This is on
#        purpose while the material is being built and marked, so nothing
#        depends on Stripe being set up yet.
# true   a customer must have paid for that specific course. This is what a
#        live site wants: set it before going public.
#
# A sign-in is required either way, because a quiz sitting is a database row
# keyed to a user. This switch relaxes the purchase check only.
#
# `php artisan payments:doctor` warns while this is off.
COURSE_REQUIRE_PURCHASE=false

# ---------------------------------------------------------------------------
# Paid courses (Stripe Checkout) - TEST MODE
# ---------------------------------------------------------------------------
# Only needed once COURSE_REQUIRE_PURCHASE=true.
# Fill these in from https://dashboard.stripe.com/test/apikeys
# and create one GBP price per product (see docs/PAID_PRODUCTS.md).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_COURSE_PRICE_ID=
STRIPE_MOCK_TEST_PRICE_ID=
STRIPE_CURRENCY=gbp

