# ---------------------------------------------------------------------------
# Mail (local)
# ---------------------------------------------------------------------------
# `log` writes each email, verification link and all, to storage/logs/laravel.log
# instead of sending it. That is the local default because nothing needs
# installing and nothing leaves the machine.
#
# Set MAIL_MAILER=mailpit instead if you have a Mailpit binary on 1025 and want
# to read mail in a mailbox UI at http://localhost:8025.
#
# The live Hostinger mailbox is NOT configured here. It only works when
# APP_ENV=production, and its values live in the .env on the server - see
# config/mail.php. Keeping them out of this file is the point: a committed .env
# travels between machines, so it should never carry a real mailbox password.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="verify@croydoncollegeofexcellence.co.uk"
MAIL_FROM_NAME="Croydon College of Excellence"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


# The live Hostinger mailbox used to be configured here, after the block above,
# so the second definition silently won. It is gone: production mail now lives
# only in the .env on the server, and only when APP_ENV=production.

# ---------------------------------------------------------------------------
# Course access
# ---------------------------------------------------------------------------
# Is a paid purchase required to open a course?
#
# false  every signed-in account can open every lesson and paper. This is on
#        purpose while the material is being built and marked, so nothing
#        depends on Stripe being set up yet.
# true   a customer must have paid for that specific course. This is what a
#        live site wants: set it before going public.
#
# A sign-in is required either way, because a quiz sitting is a database row
# keyed to a user. This switch relaxes the purchase check only.
#
# `php artisan payments:doctor` warns while this is off.
COURSE_REQUIRE_PURCHASE=false

# ---------------------------------------------------------------------------
# Paid courses (Stripe Checkout) - TEST MODE
# ---------------------------------------------------------------------------
# Only needed once COURSE_REQUIRE_PURCHASE=true.
# Fill these in from https://dashboard.stripe.com/test/apikeys
# and create one GBP price per product (see docs/PAID_PRODUCTS.md).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300
STRIPE_COURSE_PRICE_ID=
STRIPE_MOCK_TEST_PRICE_ID=
STRIPE_CURRENCY=gbp
