APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=croydon_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Three states, one variable. See config/mail.php.
#
#   MAIL_MAILER=log      anywhere else. Writes the whole email, including any
#                        verification link, to storage/logs/laravel.log. No
#                        setup, and nothing leaves the machine.
#   MAIL_MAILER=mailpit  if you have a Mailpit binary on 127.0.0.1:1025 and
#                        want to read mail in a mailbox UI at :8025.
#   MAIL_MAILER=smtp     production only. Reads the Hostinger values below.
#
# The smtp mailer is deliberately inert unless APP_ENV=production, so leaving
# these values in a local .env cannot send anything. That is the whole point:
# this file is committed, so it should never hold a real mailbox password.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production only, and only read when APP_ENV=production. Set these in the
# .env on the server, not in a copy of this file that lives in the repo.
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl
# MAIL_USERNAME=
# MAIL_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# Course access
# ---------------------------------------------------------------------------
# Does a customer have to have paid before they can open a course?
#
# false  any signed-in account can open every lesson and paper. This is on
#        purpose while the material is being built and marked, so nothing
#        depends on Stripe being set up yet.
# true   a customer must have paid for that specific course. This is what a
#        live site wants: set it before going public.
#
# A sign-in is required either way, because a quiz sitting is a database row
# keyed to a user. This switch relaxes the purchase check only.
#
# `php artisan payments:doctor` warns while this is off.
COURSE_REQUIRE_PURCHASE=false

# ---------------------------------------------------------------------------
# Paid courses (Stripe Checkout) - TEST MODE
# ---------------------------------------------------------------------------
# Start in TEST MODE. Copy the values from
# https://dashboard.stripe.com/test/apikeys and leave the keys empty until
# you have them - the app will report a friendly error instead of failing.

# Publishable key (safe for the browser): pk_test_... / pk_live_...
STRIPE_KEY=

# Secret key (server only, never commit this): sk_test_... / sk_live_...
STRIPE_SECRET=

# Signing secret of your webhook endpoint. Stripe shows this once, when the
# endpoint is created:
#   stripe listen --forward-to localhost:8000/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Seconds of clock drift tolerated when validating a webhook signature.
STRIPE_WEBHOOK_TOLERANCE=300

# Stripe Price ids, one per product. Create two one-off prices in GBP
# (Products -> Price -> One-time payment):
#   Life in the UK Course : 99.00 GBP
#   24 Mock Tests         : 49.00 GBP
STRIPE_COURSE_PRICE_ID=
STRIPE_MOCK_TEST_PRICE_ID=

# All products are priced in British pounds.
STRIPE_CURRENCY=gbp

# Leave blank to track the API version bundled with stripe/stripe-php.
# STRIPE_API_VERSION=2024-06-20
